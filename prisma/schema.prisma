// Notar-E Services — Database Schema
// Production datasource is PostgreSQL (Supabase). See README.md for local
// development setup (a local Postgres instance or a free Supabase project).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// ---------- Business configuration (singleton row, id = "default") ----------

model BusinessSettings {
  id                   String   @id @default("default")
  businessName         String   @default("Notar-E Services")
  phone                String   @default("(313) 555-0142")
  email                String   @default("hello@notareservices.com")
  serviceArea          String   @default("Metro Detroit & Southeast Michigan")
  addressLine          String   @default("Serving Wayne, Oakland, Macomb & Washtenaw Counties")
  logoNotes            String   @default("")
  facebookUrl          String   @default("")
  instagramUrl         String   @default("")
  linkedinUrl          String   @default("")
  googleBusinessUrl    String   @default("")

  // Availability
  appointmentDurationMinutes Int     @default(20)
  bufferMinutes              Int     @default(10)
  minNoticeHours             Int     @default(4)
  maxAdvanceDays             Int     @default(60)
  vacationMode               Boolean @default(false)
  vacationMessage            String  @default("")

  // Goal tracker
  goalAmountCents      Int      @default(5000000) // $50,000
  goalDeadline         DateTime @default("2027-05-31T00:00:00.000Z")
  goalStartDate        DateTime @default(now())

  // Homepage wording (editable)
  heroHeadline         String   @default("Notarization, wherever you are.")
  heroSubheadline      String   @default("Mobile and online notary services built for individuals and businesses.")

  // Daily scorecard / outreach targets
  targetBusinessesContacted Int @default(20)
  targetCalls               Int @default(10)
  targetEmails               Int @default(10)
  targetFollowUps           Int @default(5)

  // Invoicing
  taxRatePercent       Float    @default(0)

  // Stripe pricing configuration
  business30IncludedAppointments Int @default(30)

  setupCompleted       Boolean  @default(false)
  demoDataSeeded       Boolean  @default(true)

  updatedAt            DateTime @updatedAt
}

model AvailabilityRule {
  id        String  @id @default(cuid())
  dayOfWeek Int     // 0 = Sunday .. 6 = Saturday
  startTime String  // "09:00"
  endTime   String  // "19:00"
  isActive  Boolean @default(true)
}

model BlackoutDate {
  id     String   @id @default(cuid())
  date   DateTime
  reason String   @default("")
}

// Admin-created manual holds on the calendar (e.g. "out of office 2-4pm") —
// these occupy slots the same way appointments do, without being a booking.
model AdminBlock {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  reason    String   @default("")
  createdAt DateTime @default(now())
}

// ---------- Pricing (editable in admin) ----------

model PricingPlan {
  id                   String   @id @default(cuid())
  key                  String   @unique // "individual" | "business10" | "business30" | "unlimited" (discontinued, kept inactive for history)
  name                 String
  billingPeriod        String   // "one_time" | "monthly"
  statutoryFeeCents    Int      // Michigan-compliant per-act notarial fee (max $10/act)
  actsIncluded         Int      @default(1)
  serviceFeeCents      Int      // travel / signing-agent / admin / handling — non-notarial
  serviceFeeLabel      String   @default("Signing Agent & Service Fee")
  totalCents           Int      // statutoryFeeCents*actsIncluded + serviceFeeCents (or monthly total)
  appointmentsIncluded Int?     // notarizations included per month (subscription numbers come from src/lib/plans.ts)
  overageFeeCents      Int?     // e.g. 7500 = $75 per additional notarization
  description          String
  features             String   // JSON array of strings
  highlight            Boolean  @default(false)
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// ---------- CRM ----------

model Client {
  id                  String    @id @default(cuid())
  name                String
  company             String    @default("")
  email               String    @default("")
  phone               String    @default("")
  clientType          String    @default("individual") // individual | realtor | title | mortgage | law_firm | property_mgmt | dealership | financial | healthcare | small_business | other
  firstAppointmentDate DateTime?
  lastAppointmentDate  DateTime?
  totalAppointments    Int       @default(0)
  totalRevenueCents    Int       @default(0)
  currentPackage       String    @default("")
  amountOwedCents      Int       @default(0)
  notes                String    @default("")
  followUpDate         DateTime?
  leadStatus           String    @default("new_lead") // new_lead|contacted|interested|proposal_sent|active_client|recurring_client|inactive|lost
  leadSource           String    @default("website")
  isDemo               Boolean   @default(false)

  // Stripe subscription tracking
  stripeCustomerId    String    @default("")
  stripeSubscriptionId String   @default("")
  currentPlanKey      String    @default("") // individual | business10 | business30 | unlimited (legacy)
  subscriptionStatus  String    @default("") // active | past_due | canceled | incomplete
  nextBillingDate     DateTime?
  monthlyUsageCount   Int       @default(0) // for business30 plan
  monthlyUsageResetDate DateTime?

  // Stripe billing cycle (from Stripe subscription)
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  appointments Appointment[]
  invoices     Invoice[]
  subscriptionEvents SubscriptionEvent[]
  accessSessions ClientAccessSession[]
  usageRecords ClientUsage[]
  businessClients BusinessClient[]
}

model Business {
  id                  String    @id @default(cuid())
  companyName         String
  category            String    // title_company|mortgage_company|real_estate_brokerage|real_estate_agent|law_firm|property_management|dealership|bank_credit_union|healthcare|senior_living|small_business|other
  contactName         String    @default("")
  email               String    @default("")
  phone               String    @default("")

  // Billing contact (may differ from primary contact)
  billingContactName  String    @default("")
  billingContactEmail String    @default("")
  billingContactPhone String    @default("")

  packageKey          String    @default("") // links to PricingPlan.key
  monthlyUsage        Int       @default(0)
  monthlyRevenueCents Int       @default(0)
  expectedMonthlyVolume Int     @default(0) // appointments/month expected, captured at inquiry
  customPricingNotes  String    @default("") // free-text custom pricing agreement notes

  contractStart       DateTime?
  contractEndDate     DateTime?
  renewalDate         DateTime?
  status              String    @default("lead") // lead|active|inactive
  notes               String    @default("")
  followUpDate        DateTime?
  leadSource          String    @default("outreach")
  isDemo              Boolean   @default(false)

  // Stripe subscription tracking
  stripeCustomerId    String    @default("")
  stripeSubscriptionId String   @default("")
  currentPlanKey      String    @default("") // business10 | business30 | unlimited (legacy, discontinued)
  subscriptionStatus  String    @default("") // active | past_due | canceled | incomplete
  nextBillingDate     DateTime?
  monthlyUsageCount   Int       @default(0) // notarizations used this billing period (cache of BusinessUsage)
  monthlyUsageResetDate DateTime?

  // Stripe billing cycle (from Stripe subscription)
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  appointments  Appointment[]
  invoices      Invoice[]
  opportunities PipelineOpportunity[]
  subscriptionEvents SubscriptionEvent[]
  usageRecords  BusinessUsage[]
  clientMembers BusinessClient[]
}

// ---------- Scheduling ----------

model Appointment {
  id                 String    @id @default(cuid())
  confirmationNumber String    @unique
  type               String    @default("in_person") // in_person | remote
  status             String    @default("scheduled")  // scheduled|completed|cancelled|no_show
  paymentStatus      String    @default("unpaid")      // unpaid|pending|partially_paid|paid|refunded|failed
  paymentMethod      String    @default("")             // card|cash|check|invoice|ach

  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id])
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  clientName  String
  company     String   @default("")
  email       String   @default("")
  phone       String   @default("")
  address     String   @default("")

  serviceType   String @default("General Notary")
  documentType  String @default("")
  numberOfActs  Int    @default(1)

  statutoryFeeCents Int @default(1000)
  travelFeeCents    Int @default(0)
  otherFeesCents    Int @default(0)
  totalAmountCents  Int @default(1000)
  amountPaidCents   Int @default(0)

  scheduledStart DateTime
  scheduledEnd   DateTime

  notes         String    @default("")
  followUpDate  DateTime?
  reminderSentAt DateTime?

  isRecurring    Boolean @default(false)
  recurrenceRule String  @default("") // "weekly" | "biweekly" | "monthly"

  source String @default("admin") // admin | public_booking
  isDemo Boolean @default(false)

  stripeCheckoutSessionId String @default("")
  stripePaymentIntentId   String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revenueEntries RevenueEntry[]
  mileageLogs    MileageLog[]
  payments       Payment[]
}

// ---------- Sales pipeline & outreach ----------

model PipelineOpportunity {
  id                  String    @id @default(cuid())
  businessName        String
  contactName         String    @default("")
  category            String    @default("other")
  stage               String    @default("new_lead") // new_lead|contacted|follow_up|interested|meeting_scheduled|proposal_sent|negotiating|won|lost
  potentialMonthlyCents Int     @default(0)
  dealValueCents      Int       @default(0) // one-time / contract value, distinct from recurring monthly potential
  probability         Int       @default(20)
  nextAction          String    @default("")
  nextFollowUpDate    DateTime?
  contactAttempts     Int       @default(0)
  lostReason          String    @default("")
  expectedCloseDate   DateTime?
  notes               String    @default("")
  sortOrder           Int       @default(0)
  isDemo              Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
}

model OutreachLog {
  id           String    @id @default(cuid())
  businessName String
  contactName  String    @default("")
  phone        String    @default("")
  email        String    @default("")
  companyType  String    @default("other")
  dateContacted DateTime @default(now())
  method       String    @default("call") // call|email|text|walk_in|linkedin|referral|meeting|proposal
  response     String    @default("no_response") // no_response|interested|not_interested|callback|voicemail
  followUpDate DateTime?
  notes        String    @default("")
  status       String    @default("new") // new|follow_up|meeting_booked|won|lost
  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

// ---------- Daily scorecard ----------

model ScorecardEntry {
  id                  String   @id @default(cuid())
  date                DateTime @unique
  businessesContacted Int      @default(0)
  calls               Int      @default(0)
  emails              Int      @default(0)
  followUps           Int      @default(0)
  socialPostDone      Boolean  @default(false)
  appointmentsCompleted Int    @default(0)
  revenueCents        Int      @default(0)
  leadsGenerated      Int      @default(0)
  isDemo              Boolean  @default(false)
}

// ---------- Money ----------

model RevenueEntry {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  amountCents   Int
  source        String   @default("manual") // manual|appointment|subscription|invoice|refund
  description   String   @default("")
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  category    String   // gas|mileage|printing|paper|ink|marketing|advertising|website|software|notary_supplies|insurance|phone|office_supplies|professional_services|other
  vendor      String   @default("")
  amountCents Int
  notes       String   @default("")
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model MileageLog {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  startLocation   String
  destination     String
  purpose         String   @default("")
  miles           Float
  clientName      String   @default("")
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id])
  clientName    String
  company       String   @default("")
  email         String   @default("")
  issueDate     DateTime @default(now())
  dueDate       DateTime
  status        String   @default("draft") // draft|sent|paid|partially_paid|overdue|cancelled|refunded
  taxCents      Int      @default(0)
  amountPaidCents Int    @default(0)
  notes         String   @default("")
  isDemo        Boolean  @default(false)

  stripePaymentLinkUrl    String @default("")
  stripeCheckoutSessionId String @default("")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         InvoiceItem[]
  payments      Payment[]
  revenueEntries RevenueEntry[]
  usageRecords  BusinessUsage[] // Overage appointments included in this invoice
  appointments  Appointment[]    // Appointments associated with this invoice
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  type           String  @default("other_service") // statutory_fee | other_service
  quantity       Int     @default(1)
  unitAmountCents Int
  amountCents    Int
}

// A single payment/refund event — powers partial payments, receipts, and
// the admin refund flow. Linked to either an Appointment or an Invoice.
model Payment {
  id            String   @id @default(cuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amountCents   Int
  method        String   @default("stripe") // stripe|cash|check|ach|other
  status        String   @default("succeeded") // pending|succeeded|refunded|failed

  stripePaymentIntentId String? @unique   // Unique constraint prevents duplicate charges
  stripeChargeId        String   @default("")
  stripeRefundId         String   @default("")
  stripeCheckoutSessionId String? @unique // Unique constraint prevents duplicate checkouts
  stripeCustomerId      String   @default("")

  paidAt        DateTime?

  createdAt     DateTime @default(now())

  // Unique constraints on non-null Stripe identifiers
  @@index([appointmentId])
  @@index([invoiceId])
}

// ---------- Growth tools ----------

model SavedScenario {
  id         String   @id @default(cuid())
  name       String
  inputsJson String   // JSON blob of calculator inputs
  createdAt  DateTime @default(now())
}

model MilestoneAchievement {
  id          String   @id @default(cuid())
  amountCents Int      @unique
  achievedAt  DateTime @default(now())
  seen        Boolean  @default(false)
}

// Track subscription lifecycle events for idempotency
model SubscriptionEvent {
  id                  String    @id @default(cuid())
  stripeEventId       String    @unique // Stripe Event ID for deduplication
  eventType           String    // customer.subscription.created | updated | deleted
  stripeSubscriptionId String

  clientId            String?
  client              Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  businessId          String?
  business            Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  dataSnapshot        String    // JSON snapshot of the event for debugging
  processed           Boolean   @default(true)
  createdAt           DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // appointment_upcoming|follow_up_due|invoice_unpaid|goal_milestone|renewal|new_booking|payment_received
  title     String
  body      String   @default("")
  link      String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Client portal access sessions (temporary codes for magic link login)
model ClientAccessSession {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  email         String   // For validation — must match client email
  codeHash      String   // Hashed access code

  expiresAt     DateTime
  usedAt        DateTime?
  ipAddress     String   @default("")

  createdAt     DateTime @default(now())
}

model LeadCapture {
  id                 String   @id @default(cuid())
  name               String
  company             String  @default("")
  email              String
  phone              String  @default("")
  serviceNeeded      String  @default("")
  businessCategory   String  @default("")
  message            String  @default("")
  estimatedAppointmentsPerMonth String @default("")
  isBusinessLead     Boolean  @default(false)
  handled            Boolean  @default(false)
  createdAt          DateTime @default(now())
}

// ---------- Subscription usage tracking ----------

// Business subscription usage (Business10 / Business30 metering + overage billing).
// One row per completed appointment; `units` = notarizations (notarial acts).
model BusinessUsage {
  id                      String   @id @default(cuid())
  businessId              String
  business                Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  appointmentId           String   @unique // Unique: each appointment counted only once

  stripeSubscriptionId    String   // Track which subscription this is for
  billingPeriodStart      DateTime // Stripe billing period start
  billingPeriodEnd        DateTime // Stripe billing period end

  planKey                 String   @default("") // plan in force when metered: business10 | business30
  units                   Int      @default(1)  // notarizations counted for this appointment
  isOverage               Boolean  @default(false)
  overageUnits            Int      @default(0)  // how many of `units` exceeded the plan's included amount
  overageUnitCents        Int      @default(0)  // rate per overage notarization at metering time ($75 = 7500)
  overageAmountCents      Int      @default(0)  // overageUnits * overageUnitCents

  // BILLING STATE: Track whether this overage has been invoiced
  billingStatus           String   @default("unbilled") // unbilled | invoiced | failed
  invoiceId               String?  // Reference to the invoice that included this overage
  invoice                 Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoicedAt              DateTime? // When this overage was included in an invoice
  stripeInvoiceItemId     String   @default("") // Stripe invoice item ID if synced

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([businessId])
  @@index([stripeSubscriptionId])
  @@index([billingPeriodStart, billingPeriodEnd])
  // CRITICAL INDEX: Find unbilled overages in current period
  @@index([billingStatus, billingPeriodStart, billingPeriodEnd])
  // CRITICAL INDEX: Prevent concurrent double-billing
  @@index([invoiceId])
}

// Client subscription usage (for individual appointments)
model ClientUsage {
  id                      String   @id @default(cuid())
  clientId                String
  client                  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  appointmentId           String   @unique // Unique: each appointment counted only once

  stripePaymentIntentId   String   @default("") // For deduplication

  amountPaidCents         Int      // Actual amount paid for this appointment
  paymentStatus           String   @default("") // succeeded | failed | refunded

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([clientId])
  @@index([stripePaymentIntentId])
}

// Business-Client authorization relationship
// Tracks which clients can manage which businesses
model BusinessClient {
  id         String   @id @default(cuid())
  businessId String
  clientId   String

  role       String   @default("member") // owner | admin | member | viewer

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Prevent duplicate relationships
  @@unique([businessId, clientId])

  // Indexes for efficient querying
  @@index([clientId])
  @@index([businessId])
}

// ---------- Careers ----------

// Roles the owner has explicitly opened. The public /careers page only
// claims "hiring" for rows where isActive = true; otherwise it invites people
// to join the Notar-E network / express interest.
model JobOpening {
  id          String   @id @default(cuid())
  title       String
  roleKey     String   @default("other") // matches CAREER_ROLES keys
  location    String   @default("Metro Detroit, MI")
  employment  String   @default("Contract") // Contract | Part-time | Full-time
  summary     String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications CareerApplication[]
}

model CareerApplication {
  id                   String    @id @default(cuid())
  firstName            String
  lastName             String
  email                String
  phone                String
  city                 String
  state                String
  roleKey              String    // commissioned_notary | mobile_notary | ron_notary | signing_agent | sales | operations | other
  jobOpeningId         String?
  jobOpening           JobOpening? @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  isCommissioned       Boolean   @default(false)
  commissionState      String    @default("")
  commissionExpiration DateTime?
  mobileExperience     String    @default("none") // none | lt1 | 1to3 | 3plus
  ronExperience        String    @default("none")
  signingAgentExperience String  @default("none")
  availability         String    @default("")
  linkedinUrl          String    @default("")
  message              String    @default("")
  status               String    @default("new") // new | reviewing | interview | approved | rejected
  adminNotes           String    @default("")
  ipAddress            String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  resume               CareerResume?

  @@index([status])
  @@index([createdAt])
}

// Resume bytes live in their own table so list queries never load them.
// Served only through an admin-authenticated route — never a public URL.
model CareerResume {
  id            String            @id @default(cuid())
  applicationId String            @unique
  application   CareerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  sizeBytes     Int
  data          Bytes
  createdAt     DateTime          @default(now())
}
