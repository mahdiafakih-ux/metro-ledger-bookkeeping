# Copy this file to .env and fill in real values.

# Postgres connection string. For local dev, either run a local Postgres
# instance or use a free Supabase project — see README "Local development".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notare_dev?schema=public"

# Long random string used to sign admin session cookies. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# Seeded on first `npm run db:seed` — sign in to /admin with these.
ADMIN_EMAIL="owner@notareservices.com"
ADMIN_PASSWORD="change-this-password"

# Public site URL, used for metadata/OpenGraph/sitemap generation and
# Stripe Checkout redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Optional integrations (safe to leave blank for local development) ----

# Stripe (payments) — never expose the secret key to the browser.
# STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY come from the Stripe Dashboard
# (API keys page). STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you
# create pointing at /api/webhooks/stripe (see README "Stripe setup").
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (transactional email) — from the Resend dashboard. RESEND_FROM_EMAIL
# must be an address on a domain you've verified with Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Notar-E Services <hello@notareservices.com>"

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# calling /api/cron/appointment-reminders. Set the same value in your Vercel
# project's environment variables. Leave blank locally to skip the check.
CRON_SECRET=""

# Twilio (SMS reminders) — prepared for future use, not required to launch.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
